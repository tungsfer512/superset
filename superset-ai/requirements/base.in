#
# Runtime dependencies for the Superset AI sidecar.
# Pattern mirrors Superset's requirements/*.in -> *.txt (pip-compile) workflow.
#
# --- Sidecar-specific (do NOT exist in Superset core) ---
fastapi
uvicorn[standard]
httpx
pydantic-settings
prison          # RISON encoding for Superset REST query params (same lib Superset uses)
sqlglot         # SQL parsing / SELECT-only guard / LIMIT enforcement
anthropic       # Claude LLM client (tool use)
openai          # OpenAI GPT connector
google-genai    # Google Gemini connector

# --- Shared with Superset: pin to the SAME versions as Superset's
#     requirements/base.txt to keep the two environments aligned.
#     (Uncomment as the corresponding feature lands.)
# redis==4.6.0
# pyjwt==2.10.1
# requests==2.32.4

# --- "Smart" modules (added in later phases) ---
# anthropic
# sqlglot
