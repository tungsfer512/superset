# Copy to .env and adjust. All vars are prefixed SUPERSET_AI_ (see config.py).
SUPERSET_AI_HOST=0.0.0.0
SUPERSET_AI_PORT=8800
SUPERSET_AI_DEBUG=false

# Superset connection (data is read ONLY through the REST API).
SUPERSET_AI_SUPERSET_BASE_URL=http://superset:8088

# LLM provider: anthropic | openai | gemini
SUPERSET_AI_LLM_PROVIDER=openai
# Optional model override; leave empty to use the provider default
# (anthropic=claude-sonnet-4-6, openai=gpt-4o, gemini=gemini-2.5-flash).
SUPERSET_AI_LLM_MODEL=gpt-4o-mini
# Only the selected provider's key is required.
SUPERSET_AI_ANTHROPIC_API_KEY=
SUPERSET_AI_OPENAI_API_KEY=
SUPERSET_AI_GEMINI_API_KEY=

# Guardrails.
SUPERSET_AI_SQL_ROW_LIMIT=1000
SUPERSET_AI_ALLOW_WRITE_TOOLS=true
SUPERSET_AI_RESPONSE_TOKEN_GUARD=25000
SUPERSET_AI_MAX_TOOL_ITERATIONS=6
SUPERSET_AI_RATE_LIMIT_PER_MIN=30

# Smart grounding (schema indexer + glossary + retriever).
SUPERSET_AI_ENABLE_GROUNDING=true
SUPERSET_AI_GROUNDING_TOP_K=5
SUPERSET_AI_SCHEMA_CACHE_TTL=300
# Path to a JSON glossary mapping Vietnamese terms -> table/column.
SUPERSET_AI_GLOSSARY_PATH=

# Extra browser origins allowed to call the sidecar (comma-separated).
SUPERSET_AI_EXTRA_CORS_ORIGINS="*"

SUPERSET_AI_CONVERSATION_DB_PATH=/app/data/conversations.db